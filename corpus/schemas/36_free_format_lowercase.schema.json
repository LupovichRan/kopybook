{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FreeRec",
  "type": "object",
  "properties": {
    "rec_id": {
      "type": "string",
      "maxLength": 6,
      "x-cobol": {
        "level": 5,
        "name": "REC-ID",
        "offset": 0,
        "size": 6,
        "pic": "X(6)",
        "usage": "DISPLAY"
      }
    },
    "amount": {
      "type": "string",
      "pattern": "^-?[0-9]{1,5}\\.[0-9]{2}$",
      "x-decimal": {
        "precision": 7,
        "scale": 2
      },
      "x-cobol": {
        "level": 5,
        "name": "AMOUNT",
        "offset": 6,
        "size": 4,
        "pic": "S9(5)V99",
        "usage": "COMP-3"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_code": {
            "type": "string",
            "maxLength": 2,
            "x-cobol": {
              "level": 10,
              "name": "ITEM-CODE",
              "offset": 10,
              "size": 2,
              "pic": "XX",
              "usage": "DISPLAY"
            }
          },
          "item_qty": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999,
            "x-cobol": {
              "level": 10,
              "name": "ITEM-QTY",
              "offset": 12,
              "size": 3,
              "pic": "9(3)",
              "usage": "DISPLAY"
            }
          }
        },
        "required": [
          "item_code",
          "item_qty"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 2,
      "x-cobol": {
        "level": 5,
        "name": "ITEMS",
        "offset": 10,
        "size": 5,
        "occurs": [
          2,
          2
        ]
      }
    }
  },
  "required": [
    "rec_id",
    "amount",
    "items"
  ],
  "additionalProperties": false,
  "x-cobol-record": {
    "name": "FREE-REC",
    "recordLength": 20,
    "minRecordLength": 20
  }
}
