{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OdoRec",
  "type": "object",
  "properties": {
    "acct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999,
      "x-cobol": {
        "level": 5,
        "name": "ACCT",
        "offset": 0,
        "size": 8,
        "pic": "9(8)",
        "usage": "DISPLAY"
      }
    },
    "txn_count": {
      "type": "integer",
      "minimum": -9999,
      "maximum": 9999,
      "x-cobol": {
        "level": 5,
        "name": "TXN-COUNT",
        "offset": 8,
        "size": 2,
        "pic": "S9(4)",
        "usage": "BINARY"
      }
    },
    "txn_amount": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^-?[0-9]{1,7}\\.[0-9]{2}$",
        "x-decimal": {
          "precision": 9,
          "scale": 2
        }
      },
      "minItems": 0,
      "maxItems": 20,
      "x-cobol": {
        "level": 5,
        "name": "TXN-AMOUNT",
        "offset": 10,
        "size": 5,
        "pic": "S9(7)V99",
        "usage": "COMP-3",
        "occurs": [
          0,
          20
        ],
        "dependingOn": "TXN-COUNT"
      }
    }
  },
  "required": [
    "acct",
    "txn_count",
    "txn_amount"
  ],
  "additionalProperties": false,
  "x-cobol-record": {
    "name": "ODO-REC",
    "recordLength": 110,
    "minRecordLength": 10
  }
}
