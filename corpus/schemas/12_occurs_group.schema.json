{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrderRec",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "maxLength": 10,
      "x-cobol": {
        "level": 5,
        "name": "ORDER-ID",
        "offset": 0,
        "size": 10,
        "pic": "X(10)",
        "usage": "DISPLAY"
      }
    },
    "line_item": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "maxLength": 8,
            "x-cobol": {
              "level": 10,
              "name": "SKU",
              "offset": 10,
              "size": 8,
              "pic": "X(8)",
              "usage": "DISPLAY"
            }
          },
          "qty": {
            "type": "integer",
            "minimum": -9999,
            "maximum": 9999,
            "x-cobol": {
              "level": 10,
              "name": "QTY",
              "offset": 18,
              "size": 2,
              "pic": "S9(4)",
              "usage": "BINARY"
            }
          },
          "unit_price": {
            "type": "string",
            "pattern": "^-?[0-9]{1,5}\\.[0-9]{2}$",
            "x-decimal": {
              "precision": 7,
              "scale": 2
            },
            "x-cobol": {
              "level": 10,
              "name": "UNIT-PRICE",
              "offset": 20,
              "size": 4,
              "pic": "S9(5)V99",
              "usage": "COMP-3"
            }
          }
        },
        "required": [
          "sku",
          "qty",
          "unit_price"
        ],
        "additionalProperties": false
      },
      "minItems": 4,
      "maxItems": 4,
      "x-cobol": {
        "level": 5,
        "name": "LINE-ITEM",
        "offset": 10,
        "size": 14,
        "occurs": [
          4,
          4
        ]
      }
    },
    "order_total": {
      "type": "string",
      "pattern": "^-?[0-9]{1,9}\\.[0-9]{2}$",
      "x-decimal": {
        "precision": 11,
        "scale": 2
      },
      "x-cobol": {
        "level": 5,
        "name": "ORDER-TOTAL",
        "offset": 66,
        "size": 6,
        "pic": "S9(9)V99",
        "usage": "COMP-3"
      }
    }
  },
  "required": [
    "order_id",
    "line_item",
    "order_total"
  ],
  "additionalProperties": false,
  "x-cobol-record": {
    "name": "ORDER-REC",
    "recordLength": 72,
    "minRecordLength": 72
  }
}
