{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FileHeader",
  "type": "object",
  "properties": {
    "fh_type": {
      "type": "string",
      "maxLength": 1,
      "x-cobol": {
        "level": 5,
        "name": "FH-TYPE",
        "offset": 0,
        "size": 1,
        "pic": "X",
        "usage": "DISPLAY"
      }
    },
    "fh_file_date": {
      "type": "integer",
      "minimum": 0,
